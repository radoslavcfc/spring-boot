# EditorConfig helps maintain consistent coding styles across different IDEs and editors
# Works with: IntelliJ IDEA, VS Code (with extension), Eclipse, NetBeans, Sublime Text
# https://editorconfig.org

root = true

# Global settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java files
[*.java]
indent_size = 4
max_line_length = 120

# Maven POM files
[pom.xml]
indent_size = 4

# Gradle files
[*.gradle]
indent_size = 4

# Properties files
[*.properties]
indent_size = 2

# YAML configuration files
[*.{yml,yaml}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# XML files (includes pom.xml)
[*.xml]
indent_size = 4

# Markdown
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Shell scripts
[*.{sh,bash}]
indent_style = space
indent_size = 2
end_of_line = lf

# Windows batch files
[*.bat]
end_of_line = crlf

# PowerShell scripts
[*.ps1]
end_of_line = crlf

